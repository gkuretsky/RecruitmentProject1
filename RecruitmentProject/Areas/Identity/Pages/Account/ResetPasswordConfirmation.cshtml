@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}

<div class="auth-shell">
    <div class="auth-shell-inner">
        <div class="hero-card">
            <p class="hero-eyebrow">Ole Miss &bull; Recruitment</p>
            <h1 class="hero-title">Password Reset!</h1>
            <p class="hero-subtitle">Your password has been reset. You can now log in with your new password.</p>
        </div>

        <div class="text-center mt-4">
            <a class="btn btn-belle" asp-page="/Account/Login" asp-area="Identity">Log in</a>
        </div>
    </div>
</div>
