@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="auth-shell">
    <div class="auth-shell-inner">
        <div class="hero-card">
            <p class="hero-eyebrow">Ole Miss &bull; Recruitment</p>
            <h1 class="hero-title">Check Your Email</h1>
            <p class="hero-subtitle">
                If an account exists with that email address, we've sent a link to reset your password.
            </p>
        </div>
    </div>
</div>
