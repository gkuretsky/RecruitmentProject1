@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="auth-shell">
    <div class="auth-shell-inner">
        <div class="hero-card">
            <p class="hero-eyebrow">Ole Miss &bull; Recruitment</p>
            <h1 class="hero-title">Reset Your Password</h1>
        </div>

        <div class="panel-card">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger panel-validation"></div>
                <input asp-for="Input.Code" type="hidden" />
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label panel-label"></label>
                    <input asp-for="Input.Email" class="form-control panel-select" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger panel-validation"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label panel-label"></label>
                    <input asp-for="Input.Password" class="form-control panel-select" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-danger panel-validation"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label panel-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control panel-select" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger panel-validation"></span>
                </div>
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-belle">Reset password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
