@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-shell">
    <div class="auth-shell-inner">
        <div class="hero-card">
            <p class="hero-eyebrow">Ole Miss &bull; Recruitment</p>
            <h1 class="hero-title">Create an Account</h1>
        </div>

        <div class="panel-card">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="All" class="text-danger panel-validation"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label panel-label"></label>
                    <input asp-for="Input.Email" class="form-control panel-select" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger panel-validation"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label panel-label"></label>
                    <input asp-for="Input.Password" class="form-control panel-select" autocomplete="new-password" aria-required="true" placeholder="Password" />
                    <span asp-validation-for="Input.Password" class="text-danger panel-validation"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label panel-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control panel-select" autocomplete="new-password" aria-required="true" placeholder="Confirm password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger panel-validation"></span>
                </div>
                <div class="text-center mt-4">
                    <button id="registerSubmit" type="submit" class="btn btn-belle">Register</button>
                </div>
            </form>
            <p class="text-center mt-3">
                Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
