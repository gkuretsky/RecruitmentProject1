@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="auth-shell">
    <div class="auth-shell-inner">
        <div class="hero-card">
            <p class="hero-eyebrow">Ole Miss &bull; Recruitment</p>
            <h1 class="hero-title">Forgot Your Password?</h1>
            <p class="hero-subtitle">No worries! Enter your email and we'll send you a reset link.</p>
        </div>

        <div class="panel-card">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger panel-validation"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label panel-label"></label>
                    <input asp-for="Input.Email" class="form-control panel-select" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger panel-validation"></span>
                </div>
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-belle">Send reset link</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
