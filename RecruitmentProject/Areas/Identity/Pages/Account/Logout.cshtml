@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="auth-shell">
    <div class="auth-shell-inner">
        <div class="hero-card">
            <p class="hero-eyebrow">Ole Miss &bull; Recruitment</p>
            <h1 class="hero-title">You've Been Logged Out</h1>
            <p class="hero-subtitle">Thanks for stopping by! Come back soon.</p>
        </div>

        <div class="text-center mt-4">
            <a class="btn btn-belle" asp-page="/Account/Login" asp-area="Identity">Log back in</a>
        </div>
    </div>
</div>
</div>
