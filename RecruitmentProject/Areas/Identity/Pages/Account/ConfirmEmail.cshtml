@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<div class="auth-shell">
    <div class="auth-shell-inner">
        <div class="hero-card">
            <p class="hero-eyebrow">Ole Miss &bull; Recruitment</p>
            <h1 class="hero-title">@Model.StatusMessage</h1>
        </div>

        <div class="text-center mt-4">
            <a class="btn btn-belle" asp-page="/Account/Login" asp-area="Identity">Log in</a>
        </div>
    </div>
</div>
