<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecruitmentProject</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RecruitmentProject.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="sidebar collapsed" id="sidebar">
                <div class="sidebar-header d-flex align-items-center p-3">
                    <button class="btn btn-sm sidebar-toggle-btn flex-shrink-0" id="sidebarToggle" type="button" aria-label="Toggle sidebar" onclick="toggleAppSidebar()">
                        <span>&#9776;</span>
                    </button>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Home"><span class="sidebar-label">Home</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/SeatingChartGenerator"><span class="sidebar-label">Mock Seating Chart Generator</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/ActiveInformation"><span class="sidebar-label">Active Information</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/PnmInformation"><span class="sidebar-label">PNM Information</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/GeneralLinks"><span class="sidebar-label">General Links</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Privacy"><span class="sidebar-label">Privacy</span></a>
                    </li>
                </ul>
            </nav>
        }

        <div id="page-content-wrapper" class="flex-grow-1">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="topbar d-flex justify-content-end align-items-center">
                    <div class="dropdown">
                        <button class="btn profile-btn dropdown-toggle" type="button" id="profileMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="profile-avatar">@User.Identity!.Name!.Substring(0, 1).ToUpper()</span>
                            <span class="profile-name">@User.Identity!.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown-menu" aria-labelledby="profileMenuButton">
                            <li><a class="dropdown-item" asp-area="" asp-page="/Profile">Edit Profile</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form id="logoutForm" class="m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Home", new { area = "" })">
                                    <button type="submit" class="dropdown-item">Log Out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            }
            <div class="container-fluid">
                <main role="main" class="pb-3 pt-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted">
                <div class="container-fluid">
                    &copy; 2026 - RecruitmentProject - <a asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <script>
        function toggleAppSidebar() {
            var sidebar = document.getElementById('sidebar');
            if (!sidebar) {
                return;
            }
            sidebar.classList.toggle('collapsed');
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
