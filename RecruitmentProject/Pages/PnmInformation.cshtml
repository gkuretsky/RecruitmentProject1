@page
@model RecruitmentProject.Pages.PnmInformationModel
@{
    ViewData["Title"] = "PNM Information";
}

<h1>PNM Information</h1>
<p>Information for potential new members (PNMs) goes here.</p>

<div class="grid-shell">
    <table class="table grid-table align-middle">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Year</th>
                <th scope="col">Major</th>
                <th scope="col">Legacy</th>
                <th scope="col">Notes</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="5" class="text-center grid-empty-row">No PNM data yet</td>
            </tr>
        </tbody>
    </table>
</div>
