@page "/"
@model HomeModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero-card">
    <p class="hero-eyebrow">Ole Miss &bull; Recruitment</p>
    <h1 class="hero-title">Welcome!</h1>
    <p class="hero-subtitle">
        Welcome to your home base for everything Recruitment! This site allows you
        to see all active information, allow you to create mock seating charts...
    </p>
@*     <p>
        <a class="btn btn-belle me-2" asp-page="/SeatingChartGenerator">Start a Mock Seating Chart</a>
        <a class="btn btn-belle-outline" asp-page="/PnmInformation">View PNM Information</a>
    </p> *@
</div>

<div class="divider-flourish">&#8226;</div>

<div class="row g-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <a class="feature-card" asp-page="/SeatingChartGenerator">
            <h3>Seating Chart Generator</h3>
            <p>Build mock seating scenarios to practice recruitment conversations before the real thing.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a class="feature-card" asp-page="/ActiveInformation">
            <h3>Active Information</h3>
            <p>Keep member details, assignments, and notes organized in one sweet spot.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a class="feature-card" asp-page="/PnmInformation">
            <h3>PNM Information</h3>
            <p>Track potential new members and everything your team needs to know about them.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a class="feature-card" asp-page="/GeneralLinks">
            <h3>General Links</h3>
            <p>Quick access to the resources, forms, and links your recruitment team relies on.</p>
        </a>
    </div>
</div>
