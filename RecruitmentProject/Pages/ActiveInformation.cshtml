@page
@model RecruitmentProject.Pages.ActiveInformationModel
@{
    ViewData["Title"] = "Active Information";
}

<h1>Active Information</h1>
<p>Information for active members goes here.</p>

<div class="grid-shell">
    <table class="table grid-table align-middle">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Year</th>
                <th scope="col">Major</th>
                <th scope="col">Role</th>
                <th scope="col">Notes</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="5" class="text-center grid-empty-row">No active member data yet</td>
            </tr>
        </tbody>
    </table>
</div>
